{
  "name": "@tsci/rushabhcodes.usb-c-e-paper-display",
  "version": "1.0.0",
  "description": "USB-C RP2040 controller for the GDEY075T7 7.5-inch raw e-paper panel",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build index.circuit.tsx",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "check:netlist": "tsci check netlist index.circuit.tsx",
    "check:placement": "tsci check placement index.circuit.tsx",
    "check:shorts": "tsci check shorts dist/index/circuit.json",
    "check:pcb-style": "tsci check pcb-style dist/index/circuit.json",
    "check:continuous-style": "python scripts/check-continuous-style.py",
    "validate": "python scripts/validate-circuit.py"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tscircuit": "0.0.3277",
    "typescript": "^5.0.0"
  },
  "author": "rushabhcodes",
  "overrides": {
    "@tscircuit/capacity-autorouter": "0.0.1153"
  }
}
