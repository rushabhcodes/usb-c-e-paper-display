{
  "name": "@tsci/rushabhcodes.usb-c-e-paper-display",
  "version": "1.3.0",
  "description": "USB-C RP2354B controller for the GDEY075T7 7.5-inch raw e-paper panel",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build index.circuit.tsx",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "check:netlist": "tsci check netlist board.circuit.tsx",
    "check:placement": "tsci check placement board.circuit.tsx",
    "check:shorts": "tsci check shorts dist/index/circuit.json",
    "check:pcb-style": "tsci check pcb-style dist/index/circuit.json",
    "check:continuous-style": "python scripts/check-continuous-style.py",
    "validate": "python scripts/validate-circuit.py",
    "check:schematic-placement": "tsci check schematic-placement board.circuit.tsx",
    "refresh:stock": "bun scripts/refresh-supplier-stock.mjs"
  },
  "devDependencies": {
    "@tscircuit/circuit-json-to-drawing": "https://jscdn.tscircuit.com/@tscircuit/circuit-json-to-drawing/0.0.7.tgz",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "tscircuit": "0.0.3285",
    "typescript": "^5.0.0"
  },
  "author": "rushabhcodes",
  "overrides": {
    "@tscircuit/capacity-autorouter": "0.0.1159"
  },
  "patchedDependencies": {
    "@tscircuit/core@0.0.2462": "patches/@tscircuit%2Fcore@0.0.2462.patch"
  }
}
